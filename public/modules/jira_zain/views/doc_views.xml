<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ ACTIONS FIRST (before any view that references them) ============ -->

    <record id="action_document" model="ir.actions.act_window">
        <field name="name">All Documents</field>
        <field name="res_model">jira_zain.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Write your first document
            </p>
            <p>Create wiki pages, meeting notes, how-to guides and more.</p>
        </field>
    </record>

    <record id="action_my_documents" model="ir.actions.act_window">
        <field name="name">My Documents</field>
        <field name="res_model">jira_zain.document</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_my_docs': 1}</field>
    </record>

    <record id="action_doc_space" model="ir.actions.act_window">
        <field name="name">Document Spaces</field>
        <field name="res_model">jira_zain.doc.space</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first space
            </p>
            <p>Spaces group documents by team: Engineering, Product, HR, etc.</p>
        </field>
    </record>

    <record id="action_doc_label" model="ir.actions.act_window">
        <field name="name">Document Labels</field>
        <field name="res_model">jira_zain.doc.label</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- ============ DOC SPACE VIEWS ============ -->

    <record id="view_doc_space_form" model="ir.ui.view">
        <field name="name">jira_zain.doc.space.form</field>
        <field name="model">jira_zain.doc.space</field>
        <field name="arch" type="xml">
            <form string="Document Space">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action"
                                name="%(jira_zain.action_document)d" icon="fa-file-text-o"
                                context="{'default_space_id': active_id, 'search_default_space_id': active_id}">
                            <field string="Documents" name="document_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Space Name..."/></h1>
                    </div>
                    <group>
                        <group string="Space Info">
                            <field name="key"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Access">
                            <field name="member_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="What is this space for?"/>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="state"/>
                                    <field name="author_id" widget="many2one_avatar_user"/>
                                    <field name="view_count"/>
                                    <field name="write_date" string="Last Modified"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_doc_space_tree" model="ir.ui.view">
        <field name="name">jira_zain.doc.space.tree</field>
        <field name="model">jira_zain.doc.space</field>
        <field name="arch" type="xml">
            <tree string="Spaces">
                <field name="sequence" widget="handle"/>
                <field name="key"/>
                <field name="name"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="document_count"/>
            </tree>
        </field>
    </record>

    <record id="view_doc_space_kanban" model="ir.ui.view">
        <field name="name">jira_zain.doc.space.kanban</field>
        <field name="model">jira_zain.doc.space</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <strong>
                                    <span class="badge text-bg-secondary me-2"><field name="key"/></span>
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <i class="fa fa-file-text-o"/> <field name="document_count"/> docs
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="owner_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ DOCUMENT VIEWS ============ -->

    <record id="view_document_form" model="ir.ui.view">
        <field name="name">jira_zain.document.form</field>
        <field name="model">jira_zain.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'published')]}"/>
                    <button name="action_review" string="Send to Review" type="object"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_draft" string="Back to Draft" type="object"
                            attrs="{'invisible': [('state', '=', 'draft')]}"/>
                    <button name="action_save_version" string="Save Version" type="object"
                            class="btn-secondary"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,review,published"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-eye" disabled="1">
                            <field string="Views" name="view_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-history" disabled="1">
                            <field string="Versions" name="version_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-sitemap" disabled="1"
                                attrs="{'invisible': [('child_count', '=', 0)]}">
                            <field string="Sub Pages" name="child_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Document Title..."/></h1>
                    </div>
                    <group>
                        <group string="Document Info">
                            <field name="space_id"/>
                            <field name="parent_id" domain="[('space_id', '=', space_id)]"/>
                            <field name="doc_type"/>
                            <field name="is_pinned"/>
                        </group>
                        <group string="Metadata">
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="last_editor_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="label_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="task_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group>
                        <field name="summary" placeholder="Brief summary..."/>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="content"
                                   placeholder="Start writing your document here..."/>
                        </page>
                        <page string="Sub Pages" name="children"
                              attrs="{'invisible': [('child_count', '=', 0)]}">
                            <field name="child_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="doc_type"/>
                                    <field name="state"/>
                                    <field name="author_id" widget="many2one_avatar_user"/>
                                    <field name="write_date"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Version History" name="versions">
                            <field name="version_ids">
                                <tree>
                                    <field name="version_number" string="V#"/>
                                    <field name="author_id" widget="many2one_avatar_user" string="Saved By"/>
                                    <field name="summary"/>
                                    <field name="create_date"/>
                                    <button name="action_restore" type="object"
                                            string="Restore" icon="fa-undo"
                                            class="btn-link"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Linked Tasks" name="tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="stage_id"/>
                                    <field name="priority" widget="priority"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_document_tree" model="ir.ui.view">
        <field name="name">jira_zain.document.tree</field>
        <field name="model">jira_zain.document</field>
        <field name="arch" type="xml">
            <tree string="Documents"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'published'"
                  decoration-warning="state == 'review'">
                <field name="name"/>
                <field name="space_id"/>
                <field name="doc_type"/>
                <field name="state"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="last_editor_id" widget="many2one_avatar_user" string="Edited By"/>
                <field name="view_count" string="Views"/>
                <field name="write_date" string="Last Modified"/>
            </tree>
        </field>
    </record>

    <record id="view_document_kanban" model="ir.ui.view">
        <field name="name">jira_zain.document.kanban</field>
        <field name="model">jira_zain.document</field>
        <field name="arch" type="xml">
            <kanban default_group_by="space_id">
                <field name="color"/>
                <field name="is_pinned"/>
                <field name="doc_type"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top mb-0">
                                    <div class="o_kanban_record_headings">
                                        <t t-if="record.is_pinned.raw_value">
                                            <span class="me-1">&#x1F4CC;</span>
                                        </t>
                                        <span class="badge text-bg-secondary me-1">
                                            <field name="doc_type"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="state"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="author_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_document_search" model="ir.ui.view">
        <field name="name">jira_zain.document.search</field>
        <field name="model">jira_zain.document</field>
        <field name="arch" type="xml">
            <search string="Search Documents">
                <field name="name"/>
                <field name="content"/>
                <field name="space_id"/>
                <field name="author_id"/>
                <field name="label_ids"/>
                <filter string="My Documents" name="my_docs" domain="[('author_id', '=', uid)]"/>
                <filter string="Pinned" name="pinned" domain="[('is_pinned', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="In Review" name="review" domain="[('state', '=', 'review')]"/>
                <separator/>
                <filter string="Pages" name="pages" domain="[('doc_type', '=', 'page')]"/>
                <filter string="Meetings" name="meetings" domain="[('doc_type', '=', 'meeting')]"/>
                <filter string="How-To" name="howtos" domain="[('doc_type', '=', 'howto')]"/>
                <group expand="0" string="Group By">
                    <filter string="Space" name="group_space" context="{'group_by': 'space_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'doc_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Author" name="group_author" context="{'group_by': 'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ LABEL VIEW ============ -->

    <record id="view_doc_label_tree" model="ir.ui.view">
        <field name="name">jira_zain.doc.label.tree</field>
        <field name="model">jira_zain.doc.label</field>
        <field name="arch" type="xml">
            <tree string="Labels" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

</odoo>
